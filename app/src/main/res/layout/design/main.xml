<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign
		android:id="@+id/_app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:theme="@style/AppTheme.AppBarOverlay">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.MaterialToolbarDesign
			android:id="@+id/_toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:subtitleTextColor="?attr/colorOnPrimary"
			app:popupTheme="@style/AppTheme.PopupOverlay" />
	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.AppBarLayoutDesign>
	<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">
		<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign
			android:id="@+id/hscroll1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">
			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/tools"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:background="?colorPrimary"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.ImageButtonDesign
					android:id="@+id/play"
					android:layout_width="50dp"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:src="@drawable/icon_play_arrow_round"
					android:scaleType="center"
					style="?android:attr/borderlessButtonStyle" />
				<org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.ImageButtonDesign
					android:id="@+id/stop"
					android:layout_width="50dp"
					android:layout_height="wrap_content"
					android:layout_margin="5dp"
					android:padding="8dp"
					android:src="@drawable/icon_stop_round"
					android:scaleType="center"
					style="?android:attr/borderlessButtonStyle" />
				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.EditTextDesign
					android:id="@+id/freqInput"
					android:layout_width="122dp"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="8000"
					android:textSize="18sp"
					android:textColor="?colorOnSurface"
					android:hint="Frequency"
					android:textColorHint="?colorOnPrimaryContainer"
					android:singleLine="true"
					android:inputType="numberSigned"
					android:imeOptions="actionDone" />
				<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.SpinnerDesign
					android:id="@+id/bytebeatTypeSpinner"
					android:layout_width="185dp"
					android:layout_height="match_parent"
					android:padding="8dp"
					android:spinnerMode="dialog" />
			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
		</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.HorizontalScrollViewDesign>
		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">
			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.EditTextDesign
				android:id="@+id/editor"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="16dp"
				android:background="?colorOnPrimary"
				android:gravity="left|top"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="?colorOnSurface"
				android:hint="Enter your formula here or open your .bb or .txt file at the file menu..."
				android:textColorHint="?colorOnPrimaryContainer" />
			<org.appdevforall.codeonthego.layouteditor.editor.palette.legacy.ListViewDesign
				android:id="@+id/listlogs"
				android:layout_width="match_parent"
				android:layout_height="300dp"
				android:padding="8dp"
				android:background="?colorOnPrimary"
				android:dividerHeight="5dp"
				android:choiceMode="none"
				android:layout_gravity="center_horizontal|bottom" />
		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.FrameLayoutDesign>
	</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
	<org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.FloatingActionButtonDesign
		android:id="@+id/_fab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:layout_gravity="right|bottom"
		app:srcCompat="@drawable/icon_chatlog_round" />
</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.CoordinatorLayoutDesign>
